---
import Base from '../layouts/Base.astro';
import { Content } from '../data/profile.md';
const title = 'About — Guy Friley / 0xguy';
const description = 'Senior Technical Support Engineer at Salesforce. Professional background, projects, education, credentials, and volunteer engineering.';
---
<Base title={title} description={description}>
  <article class="professional-profile"><Content /></article>
  <footer><p>Profile maintained from <a href="https://github.com/0xguy07/0xguy07/blob/main/README.md">my GitHub profile README</a>.</p></footer>
</Base>
<style>
  .professional-profile { overflow-wrap: anywhere; }
  .professional-profile :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-size: .9rem; }
  .professional-profile :global(th), .professional-profile :global(td) { padding: .7rem; text-align: left; border-bottom: 1px solid var(--bg-highlight); min-width: 12rem; }
  .professional-profile :global(th) { color: var(--accent-bright); }
</style>
